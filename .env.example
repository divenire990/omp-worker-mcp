# Path or binary name for the Oh My Pi (OMP) CLI executable.
# Default: "omp" (assumes it is available on system PATH)
# Examples:
#   Windows: OMP_WORKER_OMP_COMMAND=omp
#            OMP_WORKER_OMP_COMMAND=C:\path\to\omp.exe
#   macOS:   OMP_WORKER_OMP_COMMAND=/usr/local/bin/omp
#   Linux:   OMP_WORKER_OMP_COMMAND=/usr/bin/omp
OMP_WORKER_OMP_COMMAND=omp

# Optional prefix arguments passed to the OMP CLI command (must be a valid JSON array string).
# Default: []
# Examples:
#   OMP_WORKER_OMP_PREFIX_ARGS=[]
#   OMP_WORKER_OMP_PREFIX_ARGS=["--profile", "default"]
OMP_WORKER_OMP_PREFIX_ARGS=[]

# Directory for storing async job state, prompt files, and runner execution logs.
# Default: ~/.codex/state/omp-worker
# Examples:
#   Windows: OMP_WORKER_STATE_DIR=C:\Users\Username\.codex\state\omp-worker
#   macOS/Linux: OMP_WORKER_STATE_DIR=/home/username/.codex/state/omp-worker
# OMP_WORKER_STATE_DIR=

# Optional custom browser automation instructions injected into worker prompts.
# If unset or empty, no browser automation rules are injected.
# Example:
#   OMP_WORKER_BROWSER_RULES=## Browser Automation Rules\n- Use headless browser\n- Timeout: 30s
# OMP_WORKER_BROWSER_RULES=

# Optional retention TTL in seconds for terminal job/group states (completed, failed, cancelled, timed_out, blocked, partial, awaiting_review).
# Default: unset (no automatic TTL-based cleanup).
# Examples:
#   OMP_WORKER_RETENTION_TTL_SECONDS=86400    # 24 hours
#   OMP_WORKER_RETENTION_TTL_SECONDS=604800   # 7 days
# OMP_WORKER_RETENTION_TTL_SECONDS=

# Optional maximum disk storage in bytes allocated for state directory jobs/groups.
# When exceeded, oldest terminal jobs and groups are cleaned up first until within limit.
# Default: unset (no automatic size limit cleanup).
# Examples:
#   OMP_WORKER_RETENTION_MAX_BYTES=1073741824   # 1 GB
#   OMP_WORKER_RETENTION_MAX_BYTES=524288000    # 500 MB
# OMP_WORKER_RETENTION_MAX_BYTES=

# Optional boolean flag to trigger state cleanup once when the MCP server starts up.
# Default: false (safe default; requires either TTL or MAX_BYTES to be set).
# Examples:
#   OMP_WORKER_AUTO_CLEANUP_ON_START=true
# OMP_WORKER_AUTO_CLEANUP_ON_START=false
